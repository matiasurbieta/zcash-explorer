<main class="py-4 lg:px-12">
  <div class="grid gap-4 mx-2 grid-cols-1 md:mx-8">
    <div class="space-y-6 lg:col-start-1 lg:col-span-2">
      <section aria-labelledby="not-found-title">
        <div class="bg-white-500 shadow rounded-lg dark:bg-gray-800">
          <div class="px-4 py-5 sm:px-6">
            <h2 id="not-found-title" class="text-lg leading-6 font-medium text-gray-900 dark:text-gray-50">
              Transaction Not Found
            </h2>
          </div>
          <div class="border-t border-gray-200 px-4 py-5 sm:px-6">
            <p class="text-sm text-gray-600 dark:text-gray-300 break-all">
              No transaction was found for ID: <span class="font-mono font-semibold text-gun-powder-500 dark:text-gray-200"><%= @txid %></span>
            </p>
            <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
              The transaction may not exist or may not yet be indexed. Please verify the transaction ID and try again.
            </p>
            <div class="mt-6">
              <a href="/" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-gun-powder-500 hover:bg-gun-powder-600 dark:bg-gray-700 dark:hover:bg-gray-600">
                Return to Home
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
